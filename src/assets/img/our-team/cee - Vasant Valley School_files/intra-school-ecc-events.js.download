(function () {
   'use strict';

   document.querySelectorAll('.cee-events').forEach(function (section) {
      var button = section.querySelector('.cee-events__more');
      var pastCards = Array.prototype.slice.call(
         section.querySelectorAll('.cee-event-card[data-event-status="past"]')
      );

      if (!button) {
         return;
      }

      button.addEventListener('click', function () {
         pastCards.forEach(function (card) {
            card.classList.remove('cee-event-card--hidden');
         });
         button.hidden = true;
         button.setAttribute('aria-expanded', 'true');
      });
   });
}());
